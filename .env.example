# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Groq AI (FREE!) — https://console.groq.com/keys
# FREE tier: 14,400 requests/day - No credit card needed!
# 10x faster than OpenAI and completely FREE!
VITE_GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs (optional) - For voice cloning
# Get your API key from: https://elevenlabs.io
# Free tier: 10,000 characters/month
# Leave empty to use browser TTS instead
VITE_ELEVENLABS_API_KEY=

# Translation is FREE with Google Translate (no API key needed!)
# DeepL is no longer required - we use free Google Translate API

# Application Configuration
VITE_APP_NAME=Manasatchi AI
VITE_APP_VERSION=0.1.0

# Feature Flags (enable/disable features during development)
VITE_ENABLE_VOICE_CLONING=false
VITE_ENABLE_TRANSLATION=false
VITE_ENABLE_SPEECH_TO_TEXT=false
